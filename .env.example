# Copy this file to .env and adjust. `./setup.sh` fills SECRET_KEY automatically.
#
#   cp .env.example .env

# --- Network binding ---------------------------------------------------------
# The address the app binds to. Leave blank to use localhost (this machine only).
# To reach it from other devices, set a LAN/VPN address here, or use a reverse proxy.
LOA_BIND_IP=
# Port on the host (the app listens on 5000 inside the container).
LOA_PORT=5001

# --- Security ----------------------------------------------------------------
# Signs session cookies. KEEP THIS SECRET. setup.sh generates one if left blank.
# Generate manually with:  openssl rand -hex 32
SECRET_KEY=
# Set to true ONLY if the app is served directly over HTTPS (not via a TLS proxy).
SESSION_COOKIE_SECURE=false

# --- Database ----------------------------------------------------------------
# Defaults are fine for a local single-user install (the DB is bound to localhost).
# CHANGE THE PASSWORD if you expose the database beyond this machine.
POSTGRES_USER=loa
POSTGRES_PASSWORD=loa
POSTGRES_DB=loa
DATABASE_URL=postgresql+psycopg2://loa:loa@db:5432/loa

# --- App ---------------------------------------------------------------------
DEFAULT_CURRENCY=GBP

# Online metadata enrichment is opt-in (dry-run / review / selective commit).
# It never runs during import. An optional Google Books API key raises rate limits.
GOOGLE_BOOKS_API_KEY=
HTTP_TIMEOUT=8

# --- E-book library ----------------------------------------------------------
# Your e-book folder is mounted READ-WRITE into the app at /media; pick the exact
# sub-folder inside the app (Admin -> E-book folder, stored in the database).
# MEDIA_HOST_DIR = the host path to mount (defaults to ./ebooks if left blank).
# BROWSE_ROOTS = colon-separated roots the in-app folder picker / scanner / renamer
# may traverse (keeps them inside your library).
MEDIA_HOST_DIR=./ebooks
BROWSE_ROOTS=/media

# --- Optional: "Describe a book" discovery -----------------------------------
# LibraryThing TALPA natural-language search. Get your own free token from
# LibraryThing if you want this feature; leave blank to disable it.
LIBRARYTHING_TALPA_TOKEN=
